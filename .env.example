# Server Manager configuration template.
# Copy this file to ".env" and adjust the values as needed.
#
# Precedence: command line > shell environment > this file.
# A non-empty value already exported in the shell is never overridden here.
#
# Values are literal (no shell expansion), may be wrapped in one pair of
# single/double quotes, and may carry a trailing " # comment" when the value
# is not quoted. Multi-line values are not supported.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------
# Command used to start the service (foreground commands only).
START_COMMAND=

# ------------------------------------------------------------------------------
# Lifecycle hooks (optional)
# ------------------------------------------------------------------------------
# Executed before the service starts. A non-zero exit status aborts the start.
BEFORE_COMMAND=
# Executed after the service starts. A non-zero exit status only warns.
AFTER_COMMAND=
# Optional readiness / health probe (exit 0 = healthy). When set, "start"
# waits for it to pass within START_WAIT seconds, and "status" reports it.
HEALTH_COMMAND=

# ------------------------------------------------------------------------------
# Logging (optional, defaults shown)
# ------------------------------------------------------------------------------
# Directory where log files are stored. Relative paths are anchored to the
# script directory; absolute paths are used as-is.
LOG_DIR=logs

# Log file name placed inside LOG_DIR (no path separators or glob characters).
LOG_FILE_NAME=server.log

# Maximum number of rotated backup files to keep.
# Set to 0 to disable backups (the old log is deleted on each start).
LOG_MAX_BACKUPS=2

# ------------------------------------------------------------------------------
# State / working directory (optional, defaults shown)
# ------------------------------------------------------------------------------
# Directory for the PID file and the lock file. Defaults to the script dir.
# Set this when the script directory is read-only (e.g., /opt, /usr/local/bin).
STATE_DIR=

# PID file name (no path separators or glob characters). Use a different name
# together with LOG_FILE_NAME to manage several instances from one directory.
PID_FILE_NAME=server.pid

# Working directory for the service and hooks. Defaults to the script dir, so
# relative START_COMMAND paths resolve consistently from any caller CWD.
WORK_DIR=

# ------------------------------------------------------------------------------
# Timing (optional, defaults shown)
# ------------------------------------------------------------------------------
# Seconds to wait for the service to become ready after it is spawned.
# At least one liveness check is always performed, even when set to 0.
START_WAIT=1

# Seconds to wait for the service to exit after SIGTERM before escalating
# to SIGKILL.
STOP_TIMEOUT=30

# Timeout (seconds) applied to BEFORE/AFTER hooks. 0 disables the timeout.
# Requires the system "timeout" command to take effect.
HOOK_TIMEOUT=0
